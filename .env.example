# Sao chép: copy .env.example .env  rồi chỉnh nếu cần.
# Postgres trong docker-compose: cổng host 5433 (xem docker-compose.yml).

NODE_ENV=development
APP_PORT=3000
GLOBAL_PREFIX=api

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ticket_rush

DB_HOST=localhost
DB_PORT=5433
DB_USER=ticket_rush
DB_PASSWORD=ticket_rush
DB_NAME=ticket_rush

JWT_SECRET=ticket-rush-dev-jwt-secret-change-in-production

# CORS cho Next.js (CSV). Mặc định backend: http://localhost:3001 nếu không set.
# FRONTEND_ORIGIN=http://localhost:3001

# Tuỳ chọn:
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_TTL_SEC=604800
